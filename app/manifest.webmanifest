{
  "id": "./",
  "name": "The Packed Rabbit",
  "short_name": "Packed Rabbit",
  "description": "The moving app that numbers every box, checks what fits through the door, sizes the truck from what you packed, and keeps proof for your deposit. Works offline; your list stays on your phone.",
